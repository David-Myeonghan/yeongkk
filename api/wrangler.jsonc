{
  "name": "yeongkk",
  "main": "./src/index.ts",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yeongkk",
      "database_id": "00000000-0000-0000-0000-000000000000", // F2 Step 2에서 진짜 값으로 바꾼다
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "ALLOWED_ORIGINS": "http://localhost:5173" }
}
