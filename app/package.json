{
  "name": "@yk/app",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "assets": "tsx scripts/generate-assets.ts"
  },
  "dependencies": {
    "expo": "^58.0.26",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-haptics": "~58.0.8",
    "expo-notifications": "~58.1.9",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-tracking-transparency": "~58.1.0",
    "react": "^19.3.1",
    "react-native": "0.88.1",
    "react-native-google-mobile-ads": "^17.4.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/react": "~19.3.0"
  },
  "expo": {
    "install": {
      "exclude": [
        "react"
      ]
    },
    "autolinking": {
      "exclude": [
        "react-native-google-mobile-ads",
        "expo-tracking-transparency"
      ]
    }
  }
