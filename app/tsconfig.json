{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": ["**/*.ts", "**/*.tsx", "../bridge/**/*.ts"],
  "exclude": ["node_modules", "ios", "android", ".expo", "dist"]
}
