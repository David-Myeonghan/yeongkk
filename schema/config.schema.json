{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeongkk/config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "features", "experiments", "api"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report", "ask", "ads"],
      "properties": {
        "report": { "type": "boolean" },
        "ask": { "type": "boolean" },
        "ads": { "type": "boolean" }
      }
    },
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "enabled", "variants"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "enabled": { "type": "boolean" },
          "variants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "weight"],
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "weight": { "type": "number", "minimum": 0 }
              }
            }
          }
        }
      }
    },
    "minShell": { "type": "string" },
    "api": { "type": "string", "pattern": "^(/(?!/)|https://)" }
  }
}
