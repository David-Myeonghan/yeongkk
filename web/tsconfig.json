{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "@yk/bridge/*": ["../bridge/*"],
      "@yk/quiz-core/*": ["../quiz-core/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
